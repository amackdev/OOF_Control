<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:animateLayoutChanges="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Fragment ViewPager for swiping -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="120dp"
        android:clipToPadding="false"/>

    <!-- Modern Floating Navigation Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_nav_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:id="@+id/bottom_nav_container"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Item 1: Display/Utils -->
            <FrameLayout
                android:id="@+id/nav_display"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/nav_item_background"
                android:clipChildren="false">

                <View
                    android:id="@+id/nav_indicator_display"
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/nav_indicator_bg" />

                <ImageView
                    android:id="@+id/nav_icon_display"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_display"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- Item 2: Performance -->
            <FrameLayout
                android:id="@+id/nav_performance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/nav_item_background"
                android:clipChildren="false">

                <View
                    android:id="@+id/nav_indicator_performance"
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:visibility="invisible"
                    android:background="@drawable/nav_indicator_bg" />

                <ImageView
                    android:id="@+id/nav_icon_performance"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_performance"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <!-- Item 3: Game Mode -->
            <FrameLayout
                android:id="@+id/nav_game_mode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/nav_item_background"
                android:clipChildren="false">

                <View
                    android:id="@+id/nav_indicator_game_mode"
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:visibility="invisible"
                    android:background="@drawable/nav_indicator_bg" />

                <ImageView
                    android:id="@+id/nav_icon_game_mode"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_gamepad"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <!-- Item 4: Charging -->
            <FrameLayout
                android:id="@+id/nav_charging"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/nav_item_background"
                android:clipChildren="false">

                <View
                    android:id="@+id/nav_indicator_charging"
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:visibility="invisible"
                    android:background="@drawable/nav_indicator_bg" />

                <ImageView
                    android:id="@+id/nav_icon_charging"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_charging"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <!-- Item 5: About -->
            <FrameLayout
                android:id="@+id/nav_about"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/nav_item_background"
                android:clipChildren="false">

                <View
                    android:id="@+id/nav_indicator_about"
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:visibility="invisible"
                    android:background="@drawable/nav_indicator_bg" />

                <ImageView
                    android:id="@+id/nav_icon_about"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_about"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
