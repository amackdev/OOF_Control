<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    android:animateLayoutChanges="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="96dp"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS &amp; TWEAKS"
            style="@style/TextAppearance.OOFControl.SectionHeader" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Display &amp; Utils"
            style="@style/TextAppearance.OOFControl.PageTitle"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="40dp" />

        <TextView
            android:id="@+id/tv_header_interaction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INTERACTION"
            style="@style/TextAppearance.OOFControl.SectionHeader"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp" />

        <!-- Touch Rate Card -->
        <LinearLayout
            android:id="@+id/card_touch_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg_flat"
            android:padding="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">
                <TextView 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:text="High Sampling Rate" 
                    android:textColor="@color/text_primary" 
                    android:textSize="16sp" 
                    android:fontFamily="sans-serif-medium" />
                <TextView 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:text="Enhanced 480Hz response" 
                    android:textColor="@color/text_secondary" 
                    android:textSize="13sp" 
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_touch_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VISUALS"
            style="@style/TextAppearance.OOFControl.SectionHeader"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp" />

        <!-- Refresh Rate Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg_flat"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Min Refresh Rate" android:textColor="@color/text_primary" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Force base refresh rate" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_refresh_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60Hz"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_refresh_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btn_60hz">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_60hz"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="60Hz" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_90hz"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="90Hz" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_120hz"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="120Hz" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- DEVICE SPOOFING SECTION -->
        <TextView
            android:id="@+id/tv_spoofing_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEVICE SPOOFING"
            style="@style/TextAppearance.OOFControl.SectionHeader"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp" />

        <!-- Grouped Spoofing Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg_flat"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <!-- PIF -->
            <LinearLayout
                android:id="@+id/card_pif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Play Integrity Fix" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spoof GMS to pass MEETS_DEVICE" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="2dp" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_pif" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:id="@+id/div1" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/glass_border" android:layout_marginVertical="16dp" />

            <!-- Bootloader -->
            <LinearLayout
                android:id="@+id/card_blspoof"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bootloader Spoofing" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hide bootloader unlock status" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="2dp" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_blspoof" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            
            <View android:id="@+id/div2" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/glass_border" android:layout_marginVertical="16dp" />

            <!-- Keybox -->
            <LinearLayout
                android:id="@+id/card_keybox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom Keybox" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Use external hardware keybox" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="2dp" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_keybox" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:id="@+id/div3" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/glass_border" android:layout_marginVertical="16dp" />

            <!-- Spoof Provider -->
            <LinearLayout
                android:id="@+id/card_spoof_provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spoof Provider" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="External provider spoofing" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="2dp" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_spoof_provider" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:id="@+id/div4" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/glass_border" android:layout_marginVertical="16dp" />

            <!-- Unlimited Photos -->
            <LinearLayout
                android:id="@+id/card_unlimphotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unlimited Storage" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pixel XL photo backup spoof" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="2dp" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_unlimphotos" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            
        </LinearLayout>

        <!-- PIF UPDATER SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PIF UPDATER"
            style="@style/TextAppearance.OOFControl.SectionHeader"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg_flat"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            
            <LinearLayout
                android:id="@+id/card_update_fingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Update Fingerprint" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trigger fingerprint update" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/glass_border" android:layout_marginVertical="16dp" />

            <LinearLayout
                android:id="@+id/card_update_keybox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Update Keybox" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/tv_keybox_path" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select XML from storage" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/glass_border" android:layout_marginVertical="16dp" />
            
            <LinearLayout
                android:id="@+id/card_spoof_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reboot required for spoofing changes" android:textColor="@color/accent" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:gravity="center" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>